# NetworkSathi Environment Variables
# Port for the Node.js server (default 3000)
PORT=3000

# Google Gemini API Key (Get yours from Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# AI Model for NetworkSathi (default: gemini-2.5-flash; fallbacks: gemini-flash-latest, gemini-flash-lite-latest)
AI_MODEL=gemini-2.5-flash
